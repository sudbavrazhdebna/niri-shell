// nshell config. Saved changes apply right away, no restart needed.
// If something here is wrong, the bar shows ⚠ (hover it for the reason)
// and keeps the previous settings.

// Icon theme for app icons. Without it, the GTK theme is used.
// icon-theme "MoreWaita-Yaru"

bar {
    // Height in pixels; icons and text are centered vertically.
    height 34
    // "top" or "bottom". At the bottom, menus open upward and notifications show
    // bottom-right, above the bar.
    position "top"

    // Modules: window-title, clock, media (what plays), tray, keyboard, network,
    // bluetooth, volume, display (brightness), battery, control.
    left "window-title"
    center "clock"
    right "media" "tray" "keyboard" "network" "bluetooth" "volume" "battery" "control"
}

clock {
    // %d day, %b month, %a weekday, %H:%M time, %S seconds.
    format "%d %b  %H:%M"
    // "monday", or "locale" for whatever the system's language says.
    week-starts "monday"
}

window-title {
    // Longer titles are cut with "…".
    max-length 80

    // "pattern" "replacement": the first matching one wins, $1 is the part in ( ).
    rewrite "^(.*) - YouTube — Mozilla Firefox$" "$1"
    rewrite "^(.*) — Mozilla Firefox$" "$1"
    rewrite "^(.*) - Text Editor$" "$1"
    rewrite "^(.*) - Discord$" "$1"
    rewrite "^(.*) - Sublime Text( \\(UNREGISTERED\\))?$" "$1"
    rewrite "^(.*) – GIMP$" "$1"
}

volume {
    // Percent per mouse wheel step.
    scroll-step 1
}

idle {
    // Locks the screen: from the control center, the lock stage, and before every sleep
    // (the lid too). Before sleep the shell waits for it to exit, so it should wait until
    // the screen is locked (veila: --wait-ready).
    lock-command "veila lock --wait-ready"

    // Windows (app ids, regexes) that keep the screen on while open. Local sound and
    // the Stay awake tile do too; niri itself counts video in browsers and players.
    inhibit-apps "vlc" "mpv" "steam_app_.*"

    // What happens after how long without input, counted from the start (not from the
    // previous step): dim (screen 5%, keyboard light off), lock, dpms (monitors off),
    // suspend. Leave one out to skip it. Times: "30s", "2m", "1h".
    on-ac {
        dim "2m"
        lock "5m"
        dpms "15m"
        suspend "30m"
    }
    on-battery {
        dim "1m"
        dpms "3m"
        lock "6m"
        suspend "10m"
    }
}

media {
    // The track's title next to the play button in the bar: "on" or "off".
    title "on"
}

launcher {
    // `nshell-msg launcher` opens it; bind it in niri, e.g.
    //   Mod+D { spawn "nshell-msg" "launcher"; }
    // Folders whose files it finds by name (hidden folders and build caches are skipped).
    search-paths "~/Documents" "~/Downloads" "~/Desktop"
}

keyboard {
    // How the OSD names layouts when you switch: a pattern and its replacement, applied
    // in order. This one drops "(US)" and the like: "English (US)" shows as "English".
    // Another example: rename "^Russian$" "Русский"
    rename " \\(.*\\)$" ""
}

wallpaper {
    // One image on every monitor, filling it (cropped, not stretched). Without this
    // section: ~/.config/wallpapers/m.jpg. `off` instead: no wallpaper from the shell.
    image "~/.config/wallpapers/m.jpg"
}

displays {
    // "auto": the laptop's own screen is off while an external monitor is on, and comes
    // back when the last one goes. "on": leave it alone.
    laptop-screen "auto"
}

dock {
    // Uncomment the next line to hide the dock.
    // off

    // Slides away until the pointer touches the bottom edge of the screen.
    // `nshell-msg show-dock` shows it for 3 seconds: bind it in niri, e.g.
    //   Mod+A { spawn "nshell-msg" "show-dock"; }
    autohide

    // App ids as niri reports them (`niri msg windows`), in order.
    // Right-click an app in the dock to pin or unpin it; this line is updated.
    pinned "com.mitchellh.ghostty" "dev.zed.Zed" "org.mozilla.firefox" "org.telegram.desktop" "sublime_text" "org.gnome.Nautilus" "clash-verge" "AmneziaVPN"
}
